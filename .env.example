# Database - SQLite (default for local demo)
DATABASE_URL=sqlite:///./drm_benchmark.db

# PostgreSQL (optional - uncomment to use with Docker)
# DATABASE_URL=postgresql://drm_user:drm_password@localhost:5432/drm_benchmarking

# Admin authentication (dev mode only - change these!)
ADMIN_EMAIL=admin@worldbank.org
ADMIN_PASSWORD=demo-password-change-me
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# App configuration
APP_HOST=127.0.0.1
APP_PORT=8001
APP_URL=http://localhost:8001
DEBUG=True
